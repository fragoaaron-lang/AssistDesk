{
  "name": "assistdesk",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "install:server": "npm install --prefix server",
    "start": "npm install --prefix server --no-fund --no-audit && npm start --prefix server",
    "migrate": "npm install --prefix server --no-fund --no-audit && npm --prefix server run migrate",
    "seed:osa-faqs": "npm --prefix server run seed:osa-faqs",
    "seed:registrar-faqs": "npm --prefix server run seed:registrar-faqs",
    "seed:accounting-faqs": "npm --prefix server run seed:accounting-faqs",
    "seed:about-tcc-faqs": "npm --prefix server run seed:about-tcc-faqs",
    "seed:maintenance-faqs": "npm --prefix server run seed:maintenance-faqs"
  }
}
