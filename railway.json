{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "npm ci --prefix server --omit=dev --no-fund --no-audit && npm ci --prefix client --no-fund --no-audit && CI=false npm run build --prefix client",
    "watchPatterns": [
      "server/**",
      "client/**",
      "railway.json"
    ]
  },
  "deploy": {
    "startCommand": "npm start --prefix server",
    "healthcheckPath": "/health",
    "healthcheckTimeout": 120,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
