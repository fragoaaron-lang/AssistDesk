# Supabase Postgres connection example
DB_DIALECT=postgres
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.mwlirhbsdjudpvpzvimm.supabase.co:5432/postgres
DB_SSL=true
PORT=3001
JWT_SECRET=change-me
CLIENT_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3005

# SMTP settings for password reset emails
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=your-smtp-username
MAIL_PASS=your-smtp-password
MAIL_FROM=AssistDesk <your-smtp-username>
# Monitored administrator inbox used for account-termination appeals
APPEAL_CONTACT_EMAIL=

# Recommended for Railway: HTTPS email delivery through Resend
# RESEND_API_KEY=re_your-api-key
# RESEND_FROM=AssistDesk <onboarding@resend.dev>

# Optional conversational AI for general questions
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.0-flash

# Optional: if you use direct host variables instead of DATABASE_URL
# DB_HOST=db.mwlirhbsdjudpvpzvimm.supabase.co
