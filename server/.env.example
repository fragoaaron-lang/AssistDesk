# Supabase Postgres connection example
DB_DIALECT=postgres
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.mwlirhbsdjudpvpzvimm.supabase.co:5432/postgres
DB_SSL=true
PORT=3001
# Required in production: set a unique, randomly generated secret of at least 32 characters.
# Example generation: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-with-a-unique-random-secret-at-least-32-characters
# In production, set these to the deployed HTTPS frontend origin, or leave unset to use the default Vercel origin.
CLIENT_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3005
# Railway's single trusted reverse-proxy hop is the production default; keep 0 for direct local development.
TRUST_PROXY_HOPS=0

# SMTP settings for password reset emails
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=your-smtp-username
MAIL_PASS=your-smtp-password
MAIL_FROM=AssistDesk <your-smtp-username>
# Monitored administrator inbox used for account-termination appeals
APPEAL_CONTACT_EMAIL=

# Recommended for Railway: HTTPS email delivery through Resend
# RESEND_API_KEY=re_your-api-key
# RESEND_FROM=AssistDesk <onboarding@resend.dev>

# Optional conversational AI for general questions
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.0-flash

# Optional: if you use direct host variables instead of DATABASE_URL
# DB_HOST=db.mwlirhbsdjudpvpzvimm.supabase.co
# DB_PORT=5432
# DB_USER=postgres
# DB_PASS=YOUR_PASSWORD
# DB_NAME=postgres
